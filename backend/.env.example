# Spendze backend environment variables
JWT_SECRET=
JWT_EXPIRE_MINUTES=
PORT=
CORS_ORIGINS=
APP_ENV=
DATABASE_PATH=
GEMINI_API_KEY=
GEMINI_MODEL=

# OAuth: set backend secrets here or in Render, never in frontend VITE_ variables.
# Local callback base; in production use https://spendze-backend.onrender.com
# Render is automatically treated as production. If this value is unset there,
# RENDER_EXTERNAL_URL is used; an explicit localhost value is rejected.
OAUTH_BACKEND_URL=http://127.0.0.1:8000
# Exact frontend origins, also included in CORS_ORIGINS. No paths or trailing slash.
# Production: https://budget-tracker.vercel.app (set both allowlists in Render).
OAUTH_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple CLIENT_ID is the Services ID. Apple requires public HTTPS callbacks.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 contents, with literal \n between lines (or dotenv-supported quoted multiline).
APPLE_PRIVATE_KEY=

# Password recovery via Resend (backend only). Existing .env values stay intact.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be an address on your verified Resend sending domain.
PASSWORD_RESET_FROM=
# Frontend origin, also in CORS_ORIGINS. HTTPS required in production.
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
